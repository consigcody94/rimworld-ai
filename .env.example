# Twitch
TWITCH_CHANNEL=your_channel_name
TWITCH_STREAM_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: needed for two-way chat replies and for setting the stream title/category via the Helix API
TWITCH_CLIENT_ID=
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local services
STREAM_PORT=18888
RIMWORLD_API=http://127.0.0.1:18800

# Voice is OFF by default: the AI talks in Twitch chat instead of speaking over the stream.
# Set to vocello (local Qwen3-TTS, needs ./Vocello built), neural (Apple Siri voice) or say to
# also speak each line aloud.
VOICE_ENGINE=off
VOCELLO_SPEAKER=aiden
VOCELLO_DELIVERY=
VOICE_NAME=com.apple.siri.natural.Nora

# Chat replies: agy (Gemini via the Antigravity CLI) | off (grounded rule-based replies only)
CHAT_LLM=agy
CHAT_LLM_MODEL=gemini-3.8-flash-low
