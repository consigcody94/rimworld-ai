# RimWorld AI Twitch Streaming Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# The Twitch channel where the stream is broadcast and where chat messages are monitored
TWITCH_CHANNEL=

# Twitch RTMP Stream Key (find this at https://dashboard.twitch.tv/settings/stream)
TWITCH_STREAM_KEY=

# Twitch OAuth Client ID (optional, for web OAuth flow at https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=

# Twitch Bot Username & OAuth Token (optional, for two-way chat replies)
# Generate a token with chat:read and chat:edit scopes at https://twitchapps.com/tmi/
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=

# Stream Studio Web Port (default 18888)
STREAM_PORT=18888

# RimWorld Bridge API URL
RIMWORLD_API=http://127.0.0.1:18800
