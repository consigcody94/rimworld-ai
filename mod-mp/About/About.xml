<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>RimWorld Multiplayer</name>
  <author>consigcody94</author>
  <packageId>consigcody94.rimworldmp</packageId>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>Multiplayer mod for RimWorld using lockstep synchronization. Supports cooperative play with synchronized game state across clients. Integrates with RimWorld AI Bridge for AI agent support.</description>
  <loadAfter>
    <li>Ludeon.RimWorld</li>
    <li>Ludeon.RimWorld.Royalty</li>
    <li>Ludeon.RimWorld.Ideology</li>
    <li>Ludeon.RimWorld.Biotech</li>
    <li>Ludeon.RimWorld.Anomaly</li>
    <li>Ludeon.RimWorld.Odyssey</li>
    <li>consigcody94.rimworldaibridge</li>
  </loadAfter>
  <modDependencies>
    <li>
      <packageId>consigcody94.rimworldaibridge</packageId>
      <displayName>RimWorld AI Bridge</displayName>
      <steamWorkshopUrl/>
      <downloadUrl/>
      <enabled>true</enabled>
    </li>
  </modDependencies>
</ModMetaData>